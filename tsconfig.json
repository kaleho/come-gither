{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"strict": true,
		"moduleResolution": "bundler",
		"importHelpers": false,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2018", "ES2020.String", "ES2021.WeakRef"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
